{
  "name": "@portfolio-cms/admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint src vite.config.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check index.html package.json tsconfig.json vite.config.ts src",
    "test": "node --experimental-strip-types --test --test-isolation=none src/features/content/content-client.test.ts src/features/content/content-validation.test.ts src/features/projects/featured-projects-model.test.ts src/features/projects/project-contract.test.ts src/features/projects/project-list-model.test.ts src/features/projects/project-workspace-route.test.ts src/features/projects/publication-readiness.test.ts src/features/shell/admin-route.test.ts src/lib/admin-theme.test.ts",
    "build": "npm run typecheck && vite build"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.9.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.2.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
