# Local development defaults. Render production uses HOST=0.0.0.0 and supplies PORT.
HOST=127.0.0.1
PORT=3000

# Local development only. Copy to .env and replace every placeholder.
# Production ADMIN_ORIGIN, PUBLIC_ORIGIN, and GITHUB_CALLBACK_URL must use HTTPS.
ADMIN_ORIGIN=http://127.0.0.1:5174
PUBLIC_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://portfolio_cms_dev:replace-with-a-strong-local-password@127.0.0.1:5432/portfolio_cms_dev
GITHUB_ADMIN_USER_ID=replace-with-your-numeric-github-user-id
GITHUB_CALLBACK_URL=http://127.0.0.1:3000/api/auth/github/callback
GITHUB_CLIENT_ID=replace-with-local-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-local-oauth-app-client-secret

# Neon Object Storage. Copy the AWS_* values from Neon Console > Storage > Connect > .env.
AWS_ACCESS_KEY_ID=replace-with-neon-storage-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-neon-storage-secret-access-key
AWS_ENDPOINT_URL_S3=https://replace-with-your-branch-storage-endpoint.neon.tech
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=uploads
