# Optional local overrides. HOST is intentionally restricted to loopback.
HOST=127.0.0.1
PORT=3000

# Local development only. Copy to .env and replace every placeholder.
ADMIN_ORIGIN=http://127.0.0.1:5174
DATABASE_URL=postgresql://portfolio_cms_dev:replace-with-a-strong-local-password@127.0.0.1:5432/portfolio_cms_dev
GITHUB_ADMIN_USER_ID=replace-with-your-numeric-github-user-id
GITHUB_CALLBACK_URL=http://127.0.0.1:3000/api/auth/github/callback
GITHUB_CLIENT_ID=replace-with-local-oauth-app-client-id
GITHUB_CLIENT_SECRET=replace-with-local-oauth-app-client-secret
