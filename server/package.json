{
  "name": "@portfolio-cms/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "lint": "eslint src tests vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.build.json vitest.config.ts src tests",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
