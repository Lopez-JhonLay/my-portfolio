{
  "name": "@portfolio-cms/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "lint": "eslint src tests vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.build.json vitest.config.ts vitest.integration.config.ts src tests",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "file-type": "^22.3.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.10",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
